  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishyaa06/prism-changelog.git"
  },
  "homepage": "https://github.com/krishyaa06/prism-changelog#readme",
  "engines": {
    "node": ">=18.17"
  }
}
