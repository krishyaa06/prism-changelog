{
  "name": "prism-changelog",
  "version": "1.0.0",
  "description": "Turns Conventional Commits into a clean, linked CHANGELOG.md, suggests the next semver version and cuts releases (bump, commit, tag) in one command.",
  "bin": {
    "changelog": "bin/changelog.js"
  },
