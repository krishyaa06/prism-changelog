    "test": "node --test"
  },
  "keywords": [
    "cli",
    "changelog",
    "conventional-commits",
    "semver",
    "release",
    "git",
    "versioning",
    "developer-tools",
    "prism-protocol"
  ],
  "author": "Soumya Bhandare (krishyaa06)",
